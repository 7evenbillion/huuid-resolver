# Supabase (shared Cedimaker ecosystem project — huuid_ table prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side ONLY. Never expose to the client. Never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resolver version reported in didResolutionMetadata and audit rows
HUUID_RESOLVER_VERSION=1.0.0

# Test-facility Ed25519 private key (JWK JSON), used ONLY by /debug/resolver
# to sign demonstration JWTs for the seeded test facility. Server-side only.
# Never commit a real value here. Format: {"kty":"OKP","crv":"Ed25519","x":"...","d":"..."}
HUUID_TEST_FACILITY_JWK=

# --- Patient self-enrollment (migration 013/014) ---

# pgcrypto passphrase for column-level PII encryption (name/DOB/sex-at-birth/
# emergency contact + phone). Minimum 32 characters. Generate with e.g.
# `openssl rand -base64 32`. Rotating this makes all existing encrypted
# columns undecryptable -- treat rotation as a real migration, not a
# routine key rotation.
HUUID_PII_ENCRYPTION_KEY=

# AES-256-GCM key for the encrypted enrollment/recovery session cookies.
# Minimum 32 characters. Generate with e.g. `openssl rand -base64 32`.
HUUID_SESSION_ENCRYPTION_KEY=

# SMS — Hubtel primary (Ghana), Africa's Talking fallback (non-Ghana Africa)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=HUUID
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Optional enrollment confirmation email (Resend)
RESEND_API_KEY=
HUUID_ENROLLMENT_FROM_EMAIL=
